# Entorno lógico. Valores válidos: development, preview, production.
VITE_APP_ENV=development

# Proyecto Supabase correspondiente al entorno. La clave publicable puede
# estar en el navegador; la seguridad depende de Auth, grants y RLS.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR

# Solo para E2E contra preview; no reutilizar credenciales de producción.
# E2E_USERNAME=empleado-e2e
# E2E_PASSWORD=REEMPLAZAR
# E2E_ADMIN_USERNAME=admin-e2e
# E2E_ADMIN_PASSWORD=REEMPLAZAR
# E2E_REQUIRE_ENV=1 # CI: hace obligatorias ambas parejas staff/admin.
